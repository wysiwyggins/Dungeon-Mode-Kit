{
  "burning": {
    "name": "Burning",
    "duration": 5,
    "attached_actor": "fire",
    "immunity": "fireproof",
    "on_apply_message": "[actor_name] catches fire!",
    "on_remove_message": "[actor_name] stops burning.",
    "on_apply_sound": "fireball"
  },

  "poisoned": {
    "name": "Poisoned",
    "duration": 10,
    "per_turn_effect": { "health": -2 },
    "immunity": "poison_immune",
    "effect_description": "You feel ill",
    "on_apply_message": "[actor_name] is poisoned!",
    "on_remove_message": "The poison wears off."
  },

  "stunned": {
    "name": "Stunned",
    "duration": 2,
    "skip_turn": true,
    "effect_description": "You can't think straight",
    "on_apply_message": "[actor_name] is stunned!",
    "on_remove_message": "[actor_name] recovers from being stunned."
  },

  "sleeping": {
    "name": "Sleeping",
    "duration": 5,
    "skip_turn": true,
    "remove_on_damage": true,
    "effect_description": "You feel drowsy",
    "on_apply_message": "[actor_name] falls asleep.",
    "on_remove_message": "[actor_name] wakes up!"
  },

  "confused": {
    "name": "Confused",
    "duration": 8,
    "random_movement": true,
    "effect_description": "Everything spins",
    "on_apply_message": "[actor_name] is confused!",
    "on_remove_message": "[actor_name] is no longer confused."
  },

  "hasted": {
    "name": "Hasted",
    "duration": 15,
    "extra_turn": true,
    "effect_description": "You feel quick",
    "on_apply_message": "[actor_name] speeds up!",
    "on_remove_message": "[actor_name] slows back down."
  },

  "slowed": {
    "name": "Slowed",
    "duration": 10,
    "skip_every_other_turn": true,
    "effect_description": "You feel sluggish",
    "on_apply_message": "[actor_name] slows down!",
    "on_remove_message": "[actor_name] returns to normal speed."
  },

  "regenerating": {
    "name": "Regenerating",
    "duration": 20,
    "per_turn_effect": { "health": 2 },
    "effect_description": "Your wounds begin to mend",
    "on_apply_message": "[actor_name] begins regenerating!",
    "on_remove_message": "The regeneration effect fades."
  },

  "paralyzed": {
    "name": "Paralyzed",
    "duration": 12,
    "skip_turn": true,
    "immunity": "gas_immune",
    "effect_description": "You can't move",
    "on_apply_message": "[actor_name] is paralyzed!",
    "on_remove_message": "[actor_name] can move again."
  },

  "blinded": {
    "name": "Blinded",
    "duration": 15,
    "on_apply_effect": { "visionRange": -3 },
    "effect_description": "Darkness closes in around you",
    "on_apply_message": "Darkness closes in around [actor_name]!",
    "on_remove_message": "[actor_name]'s vision clears."
  },

  "flying": {
    "name": "Flying",
    "duration": 30,
    "flying": true,
    "effect_description": "You hover above the ground",
    "on_apply_message": "[actor_name] rises into the air!",
    "on_remove_message": "[actor_name] drifts back to the ground."
  }
}
