{
  "burning": {
    "name": "Burning",
    "duration": 5,
    "attached_actor": "fire",
    "immunity": "fireproof",
    "on_apply_message": "[actor_name] catches fire!",
    "on_remove_message": "[actor_name] stops burning.",
    "on_apply_sound": "fireball"
  },

  "poisoned": {
    "name": "Poisoned",
    "duration": 20,
    "per_turn_effect": { "health": -2 },
    "immunity": "poison_immune",
    "effect_description": "You feel ill",
    "on_apply_message": "[actor_name] is poisoned!",
    "on_remove_message": "The poison wears off."
  },

  "stunned": {
    "name": "Stunned",
    "duration": 2,
    "skip_turn": true,
    "effect_description": "You can't think straight",
    "on_apply_message": "[actor_name] is stunned!",
    "on_remove_message": "[actor_name] recovers from being stunned."
  },

  "sleeping": {
    "name": "Sleeping",
    "duration": 10,
    "skip_turn": true,
    "remove_on_damage": true,
    "effect_description": "You feel drowsy",
    "on_apply_message": "[actor_name] falls asleep.",
    "on_remove_message": "[actor_name] wakes up!"
  },

  "confused": {
    "name": "Confused",
    "duration": 100,
    "random_movement": true,
    "effect_description": "Everything spins",
    "on_apply_message": "[actor_name] is confused!",
    "on_remove_message": "[actor_name] is no longer confused."
  },

  "hasted": {
    "name": "Hasted",
    "duration": 100,
    "extra_turn": true,
    "effect_description": "You feel quick",
    "on_apply_message": "[actor_name] speeds up!",
    "on_remove_message": "[actor_name] slows back down."
  },

  "slowed": {
    "name": "Slowed",
    "duration": 100,
    "skip_every_other_turn": true,
    "effect_description": "You feel sluggish",
    "on_apply_message": "[actor_name] slows down!",
    "on_remove_message": "[actor_name] returns to normal speed."
  },

  "regenerating": {
    "name": "Regenerating",
    "duration": 100,
    "per_turn_effect": { "health": 2 },
    "effect_description": "Your wounds begin to mend",
    "on_apply_message": "[actor_name] begins regenerating!",
    "on_remove_message": "The regeneration effect fades."
  },

  "paralyzed": {
    "name": "Paralyzed",
    "duration": 12,
    "skip_turn": true,
    "immunity": "gas_immune",
    "effect_description": "You can't move",
    "on_apply_message": "[actor_name] is paralyzed!",
    "on_remove_message": "[actor_name] can move again."
  },

  "blinded": {
    "name": "Blinded",
    "duration": 100,
    "on_apply_effect": { "visionRange": -3 },
    "effect_description": "Darkness closes in around you",
    "on_apply_message": "Darkness closes in around [actor_name]!",
    "on_remove_message": "[actor_name]'s vision clears."
  },

  "flying": {
    "name": "Flying",
    "duration": 100,
    "flying": true,
    "effect_description": "You hover above the ground",
    "on_apply_message": "[actor_name] rises into the air!",
    "on_remove_message": "[actor_name] drifts back to the ground."
  },

  "hallucinating": {
    "name": "Hallucinating",
    "duration": 150,
    "hallucinating": true,
    "effect_description": "Nothing looks right",
    "on_apply_message": "The world begins to shift and melt around [actor_name]!",
    "on_remove_message": "[actor_name]'s vision clears."
  },

  "nauseated": {
    "name": "Nauseated",
    "duration": 15,
    "skip_turn_chance": 0.25,
    "immunity": "gas_immune",
    "effect_description": "Your stomach churns",
    "on_apply_message": "[actor_name] feels nauseated!",
    "on_remove_message": "[actor_name]'s stomach settles."
  },

  "starving": {
    "name": "Starving",
    "duration": -1,
    "player_only": true,
    "random_apply_states": [
      { "state": "sleeping", "chance": 0.08, "duration": 2, "message": "You faint from hunger!" },
      { "state": "nauseated", "chance": 0.12, "message": "Your empty stomach churns!" }
    ],
    "on_remove_message": "You no longer feel like you're starving."
  },

  "invisible": {
    "name": "Invisible",
    "duration": 100,
    "invisible": true,
    "effect_description": "You fade from sight",
    "on_apply_message": "[actor_name] fades from sight!",
    "on_remove_message": "[actor_name] becomes visible again."
  },

  "fireproof_temp": {
    "name": "Fire Immune",
    "duration": 100,
    "grants_immunity": "fireproof",
    "effect_description": "Flames cannot touch you",
    "on_apply_message": "[actor_name] is wreathed in a protective shimmer!",
    "on_remove_message": "The fire immunity wears off."
  },

  "telepathic": {
    "name": "Telepathic",
    "duration": 150,
    "telepathic": true,
    "player_only": true,
    "effect_description": "You sense every living mind",
    "on_apply_message": "Your mind expands — you sense every living creature!",
    "on_remove_message": "The telepathic awareness fades."
  },

  "stuck": {
    "name": "Stuck",
    "duration": -1,
    "stuck": true,
    "escape_chance": 0.33,
    "effect_description": "You're held fast",
    "on_apply_message": "[actor_name] is stuck fast!",
    "on_remove_message": "[actor_name] breaks free!"
  }
}
